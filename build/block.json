{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "slidey-panel/panel",
  "version": "1.0",
  "title": "Slidey Panel",
  "category": "design",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Slidey Panel"
    },
    "mode": {
      "type": "string"
    },
    "buttonIcon": {
      "type": "string",
      "default": "title"
    },
    "menuIcon": {
      "type": "string",
      "default": "menu"
    },
    "justifyContent": {
      "type": "string"
    },
    "style": {
      "type": "object"
    }
  },
  "description": "Shows a button that opens a sliding panel.",
  "example": {
    "example": {
      "attributes": {
        "title": "Slidey Panel",
        "mode": "block"
      }
    }
  },
  "supports": {
    "html": false,
    "align": false,
    "layout": false,
    "color": {
      "__experimentalSkipSerialization": true,
      "text": true,
      "background": true,
      "gradients": true,
      "link": true
    },
    "typography": {
      "__experimentalSkipSerialization": [
        "fontSize",
        "lineHeight",
        "fontFamily",
        "fontStyle",
        "fontWeight",
        "letterSpacing",
        "textDecoration",
        "textTransform"
      ],
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true
    },
    "spacing": {
      "__experimentalSkipSerialization": true,
      "padding": true
    },
    "dimensions": {
      "minHeight": true
    },
    "__experimentalBorder": {
      "__experimentalSkipSerialization": true,
      "__experimentalDefaultControls": {
        "color": true,
        "radius": true,
        "style": true,
        "width": true
      },
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "selectors": {
    "root": ".wp-block-slidey-panel-panel .slidey-panel-open-button"
  },
  "textdomain": "slidey-panel",
  "editorStyle": "file:./index.css",
  "editorScript": "file:./index.js"
}
